%% test_fk_ik.m - 快速验证 fk_space_robot 和 ik_space_robot
clear; clc;

%% 测试1: 零位
fprintf('--- 测试1: 零位 ---\n');
[pos, eul] = fk_space_robot(zeros(7,1));
fprintf('位置: (%.0f, %.0f, %.0f) mm\n', pos*1000);
fprintf('欧拉角: (%.1f, %.1f, %.1f) deg\n\n', rad2deg(eul));

%% 测试2: 正逆一致性 (平面)
fprintf('--- 测试2: 零位正运动学 -> 逆运动学 ---\n');
[pos0, eul0] = fk_space_robot(zeros(7,1));
sols = ik_space_robot(pos0(1), pos0(2), pos0(3), eul0(1), eul0(2), eul0(3));
fprintf('找到 %d 组解\n', length(sols));
for i = 1:min(length(sols),3)
    [pos_v, eul_v] = fk_space_robot(sols(i).theta);
    fprintf('  解%d: 关节角(deg)=', i);
    fprintf(' %.1f', rad2deg(sols(i).theta));
    fprintf(' | 位置=(%.0f,%.0f,%.0f)mm 误差=%.2e\n', pos_v*1000, sols(i).error);
end
fprintf('\n');

%% 测试3: Step 1 摆动中途 (D=270mm, dz=-215mm)
fprintf('--- 测试3: 平面IK (D=270mm, dz=-215mm) ---\n');
% 相对B端偏移 D=270mm, dz=-215mm → 绝对位姿
x_tgt = 0.270; z_tgt = -0.215;  % B端在原点
[pos1, eul1] = fk_space_robot(zeros(7,1));
% 将相对偏移转为绝对位姿
x_abs = x_tgt; z_abs = z_tgt;
sols2 = ik_space_robot(x_abs, 0, z_abs, 0, 0, 0);
fprintf('找到 %d 组解\n', length(sols2));
for i = 1:min(length(sols2),3)
    [pos_v, eul_v] = fk_space_robot(sols2(i).theta);
    fprintf('  解%d: 关节角(deg)=', i);
    fprintf(' %.1f', rad2deg(sols2(i).theta));
    fprintf(' | 位置=(%.0f,%.0f,%.0f)mm\n', pos_v*1000);
end
fprintf('\n');

%% 测试4: 随机位姿验证 (5组)
fprintf('--- 测试4: 随机位姿正逆一致性 ---\n');
rng(42);
for k = 1:5
    th_rand = (rand(7,1)-0.5)*pi;
    [p_rand, e_rand] = fk_space_robot(th_rand);
    sols3 = ik_space_robot(p_rand(1), p_rand(2), p_rand(3), e_rand(1), e_rand(2), e_rand(3));
    ok = false;
    for i = 1:length(sols3)
        if sols3(i).error < 0.001
            ok = true; break;
        end
    end
    if ok, fprintf('  第%d组: 通过 | %d解\n', k, length(sols3));
    else,  fprintf('  第%d组: 失败\n', k); end
end
fprintf('\n===== 测试完成 =====\n');


