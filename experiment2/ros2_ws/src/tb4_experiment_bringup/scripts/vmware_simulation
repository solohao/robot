set -euo pipefail

if ! command -v ros2 >/dev/null 2>&1; then
  echo "ROS 2 is not loaded. Source /opt/ros/humble/setup.bash first." >&2
  exit 1
fi

ros_distro="${ROS_DISTRO:-humble}"
ros_share="/opt/ros/${ros_distro}/share"
description_source="${ros_share}/turtlebot4_description"
create_description_source="${ros_share}/irobot_create_description"
create_ignition_source="${ros_share}/irobot_create_ignition_bringup"
world_source="${ros_share}/turtlebot4_ignition_bringup/worlds/warehouse.sdf"

if [[ ! -d "${description_source}" ||
      ! -d "${create_description_source}" ||
      ! -d "${create_ignition_source}" ||
      ! -f "${world_source}" ]]; then
  echo "TurtleBot4 simulator assets were not found under ${ros_share}." >&2
  exit 1
fi

cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/tb4_experiment_bringup/vmware"
overlay_root="${cache_root}/overlay"
description_target="${overlay_root}/share/turtlebot4_description"
create_description_target="${overlay_root}/share/irobot_create_description"
create_ignition_target="${overlay_root}/share/irobot_create_ignition_bringup"
world_target="${cache_root}/warehouse-low-resource.sdf"

mkdir -p \
  "${description_target}" \
  "${create_description_target}" \
  "${create_ignition_target}"
cp -R "${description_source}/." "${description_target}/"
cp -R "${create_description_source}/." "${create_description_target}/"
cp -R "${create_ignition_source}/." "${create_ignition_target}/"
mkdir -p "${overlay_root}/share/ament_index/resource_index/packages"
touch \
  "${overlay_root}/share/ament_index/resource_index/packages/irobot_create_description" \
  "${overlay_root}/share/ament_index/resource_index/packages/irobot_create_ignition_bringup" \
  "${overlay_root}/share/ament_index/resource_index/packages/turtlebot4_description"

cp "${world_source}" "${world_target}"
sed -i \
  's#<max_step_size>0.003</max_step_size>#<max_step_size>0.1</max_step_size>#' \
  "${world_target}"

oakd_xacro="${description_target}/urdf/sensors/oakd.urdf.xacro"
sed -i \
  's#<always_on>1</always_on>#<always_on>0</always_on>#;
   s#<update_rate>30</update_rate>#<update_rate>1</update_rate>#;
   s#<visualize>true</visualize>#<visualize>false</visualize>#' \
  "${oakd_xacro}"

rplidar_xacro="${description_target}/urdf/sensors/rplidar.urdf.xacro"
sed -i \
  's#update_rate="62.0" visualize="1"#update_rate="10.0" visualize="false"#' \
  "${rplidar_xacro}"

cliff_xacro="${create_description_target}/urdf/sensors/cliff_sensor.urdf.xacro"
sed -i \
  's#name="update_rate"         value="62"#name="update_rate"         value="1"#' \
  "${cliff_xacro}"

ir_intensity_xacro="${create_description_target}/urdf/sensors/ir_intensity.urdf.xacro"
sed -i \
  's#update_rate:=62.0#update_rate:=1.0#' \
  "${ir_intensity_xacro}"

create_common_xacro="${create_description_target}/urdf/common_properties.urdf.xacro"
sed -i \
  's#<always_on>true</always_on>#<always_on>false</always_on>#g' \
  "${create_common_xacro}"

create_bridge_launch="${create_ignition_target}/launch/create3_ros_ignition_bridge.launch.py"
sed -i \
  '/^[[:space:]]*ld\.add_action(cliff_bridges)[[:space:]]*$/d;
   /^[[:space:]]*ld\.add_action(ir_bridges)[[:space:]]*$/d' \
  "${create_bridge_launch}"

if ! grep -Fq '<max_step_size>0.1</max_step_size>' "${world_target}"; then
  echo "The warehouse physics preset could not be applied." >&2
  exit 1
fi

if ! grep -Fq '<always_on>0</always_on>' "${oakd_xacro}" ||
   ! grep -Fq '<update_rate>1</update_rate>' "${oakd_xacro}" ||
   ! grep -Fq '<visualize>false</visualize>' "${oakd_xacro}"; then
  echo "The OAK-D low-resource preset could not be applied." >&2
  exit 1
fi

if ! grep -Fq \
  'update_rate="10.0" visualize="false"' "${rplidar_xacro}"; then
  echo "The RPLIDAR low-resource preset could not be applied." >&2
  exit 1
fi

if ! grep -Fq 'name="update_rate"         value="1"' "${cliff_xacro}" ||
   ! grep -Fq 'update_rate:=1.0' "${ir_intensity_xacro}"; then
  echo "The Create 3 sensor low-resource preset could not be applied." >&2
  exit 1
fi

if ! grep -Fq '<always_on>false</always_on>' "${create_common_xacro}" ||
   grep -Fq '<always_on>true</always_on>' "${create_common_xacro}" ||
   grep -Eq \
     'ld\.add_action\((cliff_bridges|ir_bridges)\)' \
     "${create_bridge_launch}"; then
  echo "The Create 3 auxiliary lidar disable preset could not be applied." >&2
  exit 1
fi

export AMENT_PREFIX_PATH="${overlay_root}${AMENT_PREFIX_PATH:+:${AMENT_PREFIX_PATH}}"
unset LIBGL_ALWAYS_SOFTWARE

launch_arguments=(
  "software_rendering:=true"
  "validate_simulation:=true"
  "gz_args:=${world_target} -r -s -v 2"
)

slam_enabled=false
nav2_selected=false
for argument in "$@"; do
  if [[ "${argument}" == "slam:=true" ]]; then
    slam_enabled=true
  elif [[ "${argument}" == start_nav2:=* ]]; then
    nav2_selected=true
  fi
done

if [[ "${slam_enabled}" == "true" && "${nav2_selected}" == "false" ]]; then
  launch_arguments+=("start_nav2:=false")
fi

command=(
  ros2 launch tb4_experiment_bringup simulation.launch.py
  "${launch_arguments[@]}"
  "$@"
)

echo "VMware preset prepared in ${cache_root}"
echo "Gazebo: Mesa software rendering, server-only"
echo "RViz: VMware hardware rendering"
echo "Create 3 cliff/IR GPU lidar: disabled"

if [[ "${TB4_VMWARE_DRY_RUN:-0}" == "1" ]]; then
  printf 'Command:'
  printf ' %q' "${command[@]}"
  printf '\n'
  exit 0
fi

exec "${command[@]}"
